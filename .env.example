# Microsoft Azure AD application credentials
# Create an app at https://portal.azure.com → Azure Active Directory → App registrations
# Required API permission: Calendars.Read (delegated)
MS_CLIENT_ID=your-azure-app-client-id
MS_CLIENT_SECRET=your-azure-app-client-secret
MS_TENANT_ID=your-azure-tenant-id

# Google Calendar credentials
# Download credentials.json from https://console.cloud.google.com → APIs & Services → Credentials
# Required scope: https://www.googleapis.com/auth/calendar
GOOGLE_CREDENTIALS_FILE=credentials.json

# Target Google Calendar (default: primary)
GOOGLE_CALENDAR_ID=primary

# Sync window for first run (days before/after today)
SYNC_WINDOW_DAYS_PAST=90
SYNC_WINDOW_DAYS_FUTURE=90
